<script>
// cursor
const dot = document.querySelector('.cursor-glow');
const ring = document.querySelector('.cursor-ring');

let mouseX = 0, mouseY = 0;
let ringX = 0, ringY = 0;

document.addEventListener('mousemove', e => {
  mouseX = e.clientX;
  mouseY = e.clientY;

  dot.style.left = mouseX + 'px';
  dot.style.top = mouseY + 'px';
});

function animateCursor(){
  ringX += (mouseX - ringX) * 0.15;
  ringY += (mouseY - ringY) * 0.15;

  ring.style.left = ringX + 'px';
  ring.style.top = ringY + 'px';

  requestAnimationFrame(animateCursor);
}
animateCursor();

// 🔥 typing animation (loop)
const roles = ["Data Analyst","Excel | Power BI | SQL","Dashboard Developer","Data Visualization Expert"];
let index = 0;
let charIndex = 0;
let isDeleting = false;

function typeEffect(){
  const current = roles[index];
  const display = current.substring(0,charIndex);
  document.getElementById("typing").textContent = display;

  if(!isDeleting && charIndex < current.length){
    charIndex++;
    setTimeout(typeEffect,80);
  }
  else if(isDeleting && charIndex > 0){
    charIndex--;
    setTimeout(typeEffect,40);
  }
  else{
    isDeleting = !isDeleting;
    if(!isDeleting){
      index = (index + 1) % roles.length;
    }
    setTimeout(typeEffect,800);
  }
}

typeEffect();

// 🔥 Connected dots (network effect)
const canvas = document.getElementById('stars');
const ctx = canvas.getContext('2d');

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let particles = [];
const PARTICLE_COUNT = 70;
const MAX_DISTANCE = 120;
let mouse = {x:null,y:null,radius:120};
let isMouseDown = false;

// track mouse for interaction
window.addEventListener('mousemove',e=>{
  mouse.x = e.clientX;
  mouse.y = e.clientY;
});

window.addEventListener('mouseout',()=>{
  mouse.x = null;
  mouse.y = null;
});

// 🖱️ click detect for attract
window.addEventListener('mousedown',()=>{isMouseDown = true;});
window.addEventListener('mouseup',()=>{isMouseDown = false;});

for(let i=0;i<PARTICLE_COUNT;i++){
  particles.push({
    x: Math.random()*canvas.width,
    y: Math.random()*canvas.height,
    vx: (Math.random()-0.5)*0.7,
    vy: (Math.random()-0.5)*0.7
  });
}

function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);

  // draw dots
  particles.forEach(p=>{
    ctx.beginPath();
    ctx.arc(p.x,p.y,2,0,Math.PI*2);
    ctx.fillStyle = "rgba(37,99,235,0.6)";
    ctx.fill();
  });

  // draw lines
  for(let i=0;i<particles.length;i++){
    for(let j=i+1;j<particles.length;j++){
      let dx = particles[i].x - particles[j].x;
      let dy = particles[i].y - particles[j].y;
      let dist = Math.sqrt(dx*dx + dy*dy);

      if(dist < MAX_DISTANCE){
        ctx.beginPath();
        ctx.moveTo(particles[i].x, particles[i].y);
        ctx.lineTo(particles[j].x, particles[j].y);
        ctx.strokeStyle = `rgba(37,99,235,${1 - dist/MAX_DISTANCE})`;
        ctx.lineWidth = 0.5;
        ctx.stroke();
      }
    }
  }
}

function update(){
  particles.forEach(p=>{
    // normal movement
    p.x += p.vx;
    p.y += p.vy;

    // 🔥 mouse interaction (repel + attract combo)
    if(mouse.x && mouse.y){
      let dx = p.x - mouse.x;
      let dy = p.y - mouse.y;
      let dist = Math.sqrt(dx*dx + dy*dy);

      if(dist < mouse.radius){
        let angle = Math.atan2(dy, dx);

        // 🖱️ LEFT CLICK = attract
        if(isMouseDown){
          let force = (mouse.radius - dist) / mouse.radius;
          p.x -= Math.cos(angle) * force * 2.5;
          p.y -= Math.sin(angle) * force * 2.5;
        }
        // 🖱️ NORMAL = repel
        else{
          let force = (mouse.radius - dist) / mouse.radius;
          p.x += Math.cos(angle) * force * 3;
          p.y += Math.sin(angle) * force * 3;
        }
      }
    }

    // boundary bounce
    if(p.x < 0 || p.x > canvas.width) p.vx *= -1;
    if(p.y < 0 || p.y > canvas.height) p.vy *= -1;
  });
}

function animateBG(){
  draw();
  update();
  requestAnimationFrame(animateBG);
}

animateBG();

</script>

</body>
